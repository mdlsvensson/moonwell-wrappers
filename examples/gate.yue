-- Copy to src/main.yue in a disposable Moonwell map configured with this library.
-- Run once normally, then set probes = true to verify callback errors remain visible and recover.
-- Type -gate in chat twice while the hero is alive. CONTRIBUTING lists every expected message.
-- Set presentation = true for a separate run of the v0.3.0 presentation gate only.
-- Set ui = true for a separate run of the v0.4.0 classic UI gate only.
-- Set frames = true for a separate run of the v0.5.0 frames gate only; it loads war3mapImported\wrappers-gate.toc.
-- Set port = true for a separate run of the v0.7.0 port prerequisites gate only (damage, pathing, sync).
-- Set additions = true for a separate run of the v0.8.0 additions gate only (art, events, weather, input).
-- Set dispose = true for a separate run of the v0.9.0 automatic disposal gate only.
-- A run with something to watch shows one thing at a time: the screen says what to look for or to do, and Esc goes on
-- to the next. Every printed line is also written to CustomMapData\moonwell-wrappers-gate.pld.
import "moonwell" as mw
import "moonwell.macros" as {:$FourCC}
import "wrappers.player" as Player
import "wrappers.unit" as Unit
import "wrappers.item" as Item
import "wrappers.destructable" as Destructable
import "wrappers.rect" as Rect
import "wrappers.region" as Region
import "wrappers.force" as Force
import "wrappers.timer" as Timer
import "wrappers.trigger" as Trigger
import "wrappers.group" as Group
import "wrappers.effect" as Effect
import "wrappers.texttag" as TextTag
import "wrappers.sound" as Sound
import "wrappers.lightning" as Lightning
import "wrappers.image" as Image
import "wrappers.ubersplat" as Ubersplat
import "wrappers.fogmodifier" as FogModifier
import "wrappers.dialog" as Dialog
import "wrappers.multiboard" as Multiboard
import "wrappers.leaderboard" as Leaderboard
import "wrappers.quest" as Quest
import "wrappers.defeatcondition" as DefeatCondition
import "wrappers.timerdialog" as TimerDialog
import "wrappers.frame" as Frame
import "wrappers.damage" as Damage
import "wrappers.sync" as Sync
import "wrappers.input" as Input
import "wrappers.weathereffect" as WeatherEffect

probes = false
presentation = false
ui = false
frames = false
port = false
additions = false
dispose = false

-- Every printed line also goes to Documents\Warcraft III\CustomMapData\moonwell-wrappers-gate.pld, written anew at
-- each line, so a run is read afterwards from the file. The library's own lines go there too: it prints through print.
printedLines = {}
screenPrint = print
_G.print = (...) ->
  screenPrint ...
  parts = [tostring(select(index, ...)) for index = 1, select("#", ...)]
  printedLines[#printedLines + 1] = table.concat parts, " "
  PreloadGenClear!
  PreloadGenStart!
  for line in *printedLines
    -- A Preload line keeps 259 characters: longer lines continue on the next.
    for at = 1, #line, 200
      Preload (line\sub(at, at + 199)\gsub "\"", "'")
  PreloadGenEnd "moonwell-wrappers-gate.pld"
  PreloadGenClear!

-- The one line that stays on screen: what to look for or to do now.
showPrompt = (text) ->
  ClearTextMessages!
  DisplayTimedTextToPlayer GetLocalPlayer!, 0, 0, 600, text

-- One thing at a time. `step` adds a step: what to look for or to do, and a function that shows it; that function may
-- return another one, which takes the thing away again. `start` shows the first step. Esc goes on to the next, and
-- after the last one `finish` runs.
stepByStep = (owner, name) ->
  steps = {}
  step = (text, show) -> steps[#steps + 1] = {:text, :show}
  start = (finish) ->
    index = 0
    leave = nil
    escape = Trigger.create!
    escape\registerPlayerEvent owner, EVENT_PLAYER_END_CINEMATIC
    advance = ->
      leaving = leave
      leave = nil
      leaving! if leaving
      index += 1
      current = steps[index]
      if current
        entered = current.show!
        leave = entered if type(entered) == "function"
        print "#{name} step #{index} of #{#steps}: #{current.text}"
        showPrompt "Step #{index} of #{#steps}. #{current.text}. Then press Esc."
      else
        escape\destroy!
        ClearTextMessages!
        finish!
    escape\addAction advance
    advance!
  step, start

-- v0.1.0 foundation: same observations as the first release.
foundationGate = (owner) ->
  unit = Unit.create owner, $FourCC("hfoo"), 0, 0, 270
  assert Unit.fromHandle(unit\getHandle!) == unit
  unit\setPosition 100, 0
  unit\setPlayerColor PLAYER_COLOR_RED
  unit\setLife 200
  unit\issuePointOrder "move", 300, 0
  group = Group.create!
  group\enumInRange 100, 0, 600
  assert group\contains unit
  print "Wrapper group size", group\getSize!
  effect = Effect.attach "Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl", unit, "origin"
  death = Trigger.create!
  death\registerUnitEvent unit, EVENT_UNIT_DEATH
  death\addAction -> print "Wrapper unit death event"
  periodic = Trigger.create!
  periodic\registerTimerEvent 1, true
  events = 0
  periodic\addAction ->
    events += 1
    if probes and events == 1
      error "intentional trigger probe"
    print "Wrapper trigger tick", events
  timer = Timer.create!
  ticks = 0
  timer\start 1, true, (self) ->
    ticks += 1
    if probes and ticks == 1
      error "intentional timer probe"
    print "Wrapper timer tick", ticks
    if ticks == 3
      unit\kill!
    if ticks == 5
      effect\destroy!
      group\destroy!
      death\destroy!
      periodic\destroy!
      unit\remove!
      self\destroy!
      effect\destroy!
      group\destroy!
      death\destroy!
      periodic\destroy!
      unit\remove!
      self\destroy!
      print "Wrapper gate cleanup passed"

-- Weak cache probe. RemoveUnit is called directly to stand in for the game removing units on its own (decay):
-- those wrappers are never disposed. The game has no collectgarbage, so a collector timer allocates garbage and records
-- locally whether a weak sentinel was collected. Garbage collection is not synchronized between clients, so units are
-- created and removed only at fixed timer times, the same on every client; only the checks and prints may differ.
churnProbe = (owner) ->
  footman = $FourCC("hfoo")
  keep = [Unit.create(owner, footman, 600, y * 60, 0) for y = 1, 5]
  stale = {}
  for i = 1, 20
    unit = Unit.create owner, footman, 800, i * 30, 0
    stale[] = unit if i <= 5
    RemoveUnit unit\getHandle!
  sentinel = setmetatable {}, __mode: "k"
  sentinel[{}] = true
  collected = false
  collector = Timer.create!
  collector\start 0.1, true, ->
    -- Short-lived tables drive the incremental collector. No game state changes here.
    for _ = 1, 2000
      setmetatable {}, nil
    collected = true if next(sentinel) == nil
  verdict = Timer.create!
  verdict\start 20, false, (self) ->
    collected = true if next(sentinel) == nil
    fresh = [Unit.create(owner, footman, 1000, y * 30, 0) for y = 1, 20]
    staleOk = true
    for unit in *fresh
      found = Unit.fromHandle unit\getHandle!
      for old in *stale
        staleOk = false if found == old
    identityOk = true
    for unit in *keep
      identityOk = false if Unit.fromHandle(unit\getHandle!) ~= unit
    print "Wrapper weak cache probe collected=#{collected} stale=#{staleOk} identity=#{identityOk}"
    print "Wrapper weak cache probe passed" if collected and staleOk and identityOk
    unit\remove! for unit in *fresh
    unit\remove! for unit in *keep
    collector\destroy!
    self\destroy!

-- v0.2.0 coverage.
broadGate = (owner) ->
  hero = Unit.create owner, $FourCC("Hpal"), -300, 0, 0
  assert hero\isHero!
  hero\addXP 1000, true
  print "Wrapper hero level", hero\getLevel!, "strength", hero\getStr(true)
  -- Storm Bolt: three levels, and not one of the Paladin's own abilities.
  stormBolt = $FourCC("AHtb")
  assert hero\addAbility(stormBolt)
  hero\setAbilityLevel stormBolt, 2
  hero\startCooldown stormBolt, 30
  print "Wrapper ability level", hero\getAbilityLevel(stormBolt), "cooldown", hero\getCooldownRemaining(stormBolt)
  claws = assert hero\addItemById($FourCC("ratc")), "no item added"
  assert hero\getItemInSlot(0) == claws
  assert hero\dropItemAt(claws, -200, 0)
  claws\setCharges 3
  print "Wrapper item", claws\getName!, "charges", claws\getCharges!
  pickups = Trigger.create!
  pickups\registerAnyUnitEvent EVENT_PLAYER_UNIT_PICKUP_ITEM
  pickups\addCondition -> Unit.fromHandle(GetTriggerUnit!) == hero
  pickups\addAction -> print "Wrapper item picked up", Item.fromHandle(GetManipulatedItem!) == claws
  tree = Destructable.create $FourCC("LTlt"), 300, 300, 270, 1, 0
  deaths = Trigger.create!
  deaths\registerDeathEvent tree
  deaths\addAction -> print "Wrapper tree death event"
  area = Rect.create 200, -100, 400, 100
  zone = Region.create!
  zone\addRect area
  entries = Trigger.create!
  entries\registerEnterRegion zone
  entries\addAction -> print "Wrapper region entered"
  team = Force.create!
  team\enumAllies owner
  print "Wrapper force players", #team\getPlayers!
  chat = Trigger.create!
  chat\registerChatEvent owner, "-gate", true
  chat\addCondition -> hero\isAlive!
  -- Cancels itself during its first evaluation; that evaluation still counts its result.
  local gateOnce
  gateOnce = chat\addCondition ->
    gateOnce!
    true
  removed = chat\addAction -> print "ERROR removed action ran"
  local once
  once = chat\addAction ->
    print "Wrapper chat once"
    once!
  chat\addAction -> print "Wrapper chat accepted"
  removed!
  probe = Trigger.create!
  if probes
    probe\registerTimerEvent 1, false
    probe\addCondition -> error "intentional condition probe"
    probe\addAction -> print "ERROR condition probe action ran"
    -- v0.6.0: exists() after removal that bypasses the wrapper, and where a wrapper error points. The failing call is
    -- an argument, evaluated in the closure's own frame: as the closure's last expression it would be a tail call,
    -- which hides the position.
    gone = Unit.create owner, $FourCC("hfoo"), -700, -700, 0
    RemoveUnit gone\getHandle!
    corpse = Unit.create owner, $FourCC("hfoo"), -700, -600, 0
    corpse\kill!
    potion = Item.create $FourCC("phea"), -700, -500
    RemoveItem potion\getHandle!
    stump = Destructable.create $FourCC("LTlt"), -704, -384, 270, 1, 0
    RemoveDestructable stump\getHandle!
    print "Wrapper exists after raw removal", gone\exists!, potion\exists!, stump\exists!
    -- The unit's type id did not read 0 in the same instant (v0.6.0 gate): check it a frame later and after 1 s.
    later = Timer.create!
    later\start 0, false, ->
      print "Wrapper unit exists after 0 s", gone\exists!
      later\start 1, false, (self) ->
        print "Wrapper unit exists after 1 s", gone\exists!
        self\destroy!
    print "Wrapper killed unit alive, exists", corpse\isAlive!, corpse\exists!
    discarded = Unit.create owner, $FourCC("hfoo"), -700, -400, 0
    discarded\remove!
    _, located = pcall -> print "ERROR no error for a removed target", hero\issueTargetOrder "smart", discarded
    print "Wrapper error location", located
    -- v0.10.0: whole numbers held as floats, where the natives take integers. The closure ends on nil: its last call
    -- would be a tail call.
    floatBoard = Multiboard.create 1, 1
    floatsOk, floatsMessage = pcall ->
      Player.fromIndex 0.0
      floatBoard\setRowCount 2.0
      hero\setColor 255.0, 255.0, 255.0, 255.0
      nil
    floatBoard\destroy!
    print "Wrapper integral floats", floatsOk, floatsMessage
    -- v0.10.0: a timer started again before it expired runs its latest callback only, and once.
    restartFirst, restartSecond = 0, 0
    restarted = Timer.create!
    restarted\start 1, false, -> restartFirst += 1
    restarted\start 1, false, -> restartSecond += 1
    restartVerdict = Timer.create!
    restartVerdict\start 3, false, (self) ->
      print "Wrapper timer restart first", restartFirst, "second", restartSecond
      restarted\destroy!
      self\destroy!
  heroes = Group.create!
  heroes\enumInRange(-300, 0, 800, (unit) -> unit\isHero!)
  print "Wrapper filtered heroes", heroes\getSize!
  steps = Timer.create!
  step = 0
  steps\start 2, true, (self) ->
    step += 1
    if step == 1
      hero\issueTargetOrder "smart", claws
    elseif step == 2
      tree\kill!
    elseif step == 3
      tree\restore tree\getMaxLife!, true
      print "Wrapper tree restored", tree\getLife!
    elseif step == 15
      assert hero\hasItem(claws), "hero did not pick up the item"
      hero\removeItem claws
      claws\remove!
      heroes\destroy!
      team\destroy!
      trigger\destroy! for trigger in *{pickups, deaths, entries, chat, probe}
      zone\destroy!
      area\destroy!
      tree\remove!
      hero\remove!
      self\destroy!
      print "Wrapper broad cleanup passed"
      churnProbe owner

-- v0.3.0 presentation, at the map centre. Run with presentation = true: one thing at a time, Esc for the next.
presentationGate = (owner) ->
  other = Player.fromIndex 1
  marker = Unit.create owner, $FourCC("hfoo"), 0, 0, 270
  -- Reveal the gate's area; the far radius and rect reveals below stay outside it.
  sight = Rect.create -1100, -500, 700, 900
  view = FogModifier.createRect owner, FOG_OF_WAR_VISIBLE, sight, true, false
  view\start!
  bell = Sound.create "Sound\\Interface\\Warning.flac"
  voice = Sound.create "Units\\Human\\Footman\\FootmanYes1.flac", is3D: true
  voice\setDistances 600, 10000
  voice\setDistanceCutoff 3000
  print "Wrapper presentation started; sound duration", bell\getDuration!
  -- Counted and removed at once. Trees snap to a 64-unit grid (sometimes further), so these are grid points well
  -- inside the box.
  box = Rect.create -1024, 448, -576, 832
  potions = {
    Item.create($FourCC("ratc"), -800, 600)
    Item.create($FourCC("phea"), -780, 620)
    Item.create($FourCC("phea"), -820, 580)
  }
  trees = {
    Destructable.create($FourCC("LTlt"), -896, 640, 270, 1, 0)
    Destructable.create($FourCC("LTlt"), -704, 640, 270, 1, 0)
  }
  potionId = $FourCC("phea")
  print "Wrapper enumerated potions", #Item.enumInRect(box, (item) -> item\getTypeId! == potionId)
  print "Wrapper enumerated trees", #Destructable.enumInRect(box)
  item\remove! for item in *potions
  tree\remove! for tree in *trees
  box\destroy!
  clap = "Abilities\\Spells\\Human\\ThunderClap\\ThunderClapCaster.mdl"
  -- Something that is over in a moment is shown again every few seconds while its step lasts.
  again = (seconds, show) ->
    show!
    repeater = Timer.create!
    repeater\start seconds, true, -> show!
    -> repeater\destroy!
  step, start = stepByStep owner, "Wrapper presentation"
  local tag, bolt, aoe, splat, far, area

  step "Look: a yellow text 'Wrapper text tag', up and left of the footman", ->
    tag = TextTag.create!
    tag\setText "Wrapper text tag", 12
    tag\setColor 255, 220, 0, 255
    tag\setPosition -250, 250, 0
    nil
  step "Look: the text has jumped onto the footman and reads 'Wrapper tag moved'", ->
    tag\setPositionOnUnit marker, 0
    tag\setText "Wrapper tag moved", 10
    -> tag\destroy!
  step "Look: 'Wrapper float' rises above the footman and fades, over and over. Never 'for another player'", ->
    again 3, ->
      TextTag.float "Wrapper float", 0, 100
      TextTag.float "Wrapper float for another player", 0, 150, player: other

  -- Chain Lightning (CLPB) faded right after creation in an earlier gate run; Drain Life is expected to stay.
  step "Look: a beam of light (Drain Life) below the footman, and it stays", ->
    bolt = Lightning.create "DRAL", -300, -250, 60, 300, -250, 60
    nil
  step "Look: the beam is now above the footman", ->
    bolt\move -300, 250, 60, 300, 250, 60
    bolt\setColor 255, 0, 0, 255
    -> bolt\destroy!

  step "Look: a circle on the ground under the footman", ->
    aoe = Image.create "ReplaceableTextures\\Selection\\SpellAreaOfEffect.blp", 256, 256, 0, 0, 1
    nil
  step "Look: the circle is green now and has moved up", ->
    aoe\setColor 0, 255, 0, 255
    aoe\setPosition 0, 300
  step "Look: the circle is gone", ->
    aoe\setVisibleFor other
    -> aoe\destroy!

  step "Look: the ground mark of a building, up and right of the footman", ->
    splat = Ubersplat.create "HMED", 350, 250
    nil
  step "Look: the ground mark fades away", ->
    splat\finish!
    -> splat\destroy!

  step "Look: left of the footman, a red see-through footman with its back to you, in the air, attacking slowly", ->
    tinted = Effect.create "units\\human\\Footman\\Footman.mdl", -400, 0
    tinted\setColor 255, 0, 0, 160
    tinted\setTimeScale 0.5
    tinted\setOrientation 90, 0, 0
    tinted\setHeight 100
    tinted\playAnimation ANIM_TYPE_ATTACK
    -> tinted\destroy!
  step "Look: left of the footman, a second footman in blue, the colour of player 2", ->
    blue = Effect.create "units\\human\\Footman\\Footman.mdl", -400, 0
    blue\setPlayerColor other
    -> blue\destroy!
  step "Look: a thunder clap flashes on the ground below the footman, again and again", ->
    again 2, -> Effect.flash clap, 0, -200
  step "Look: a thunder clap flashes on the footman itself, again and again", ->
    again 2, -> Effect.flashOn clap, marker, "origin"

  step "Look at the minimap: a lit circle far out towards the top right", ->
    near = FogModifier.createRadius owner, FOG_OF_WAR_VISIBLE, 2400, 2400, 400, true, false
    near\start!
    -> near\destroy!
  step "Look at the minimap: a lit square far out towards the bottom left", ->
    area = Rect.create -2800, -2800, -2000, -2000
    far = FogModifier.createRect owner, FOG_OF_WAR_VISIBLE, area, true, false
    far\start!
  -- A stopped modifier leaves its area explored, so the eye may see no change: the file says whether the square's
  -- middle is still in sight. Each line is printed a step after the change, when the game has redrawn its fog.
  inSight = -> IsVisibleToPlayer -2400, -2400, owner\getHandle!
  step "Look at the minimap: the square is darker than before, or looks the same", ->
    print "Wrapper fog square in sight before the stop", inSight!
    far\stop!
    ->
      fogged = IsFoggedToPlayer -2400, -2400, owner\getHandle!
      print "Wrapper fog square in sight after the stop", inSight!, "fogged", fogged
      far\destroy!
      area\destroy!

  step "Listen: a warning sound played just now", ->
    bell\play!
    print "Wrapper sound play"
  step "Listen: a knight's voice spoke just now", ->
    print "Wrapper sound duration after play", bell\getDuration!
    bell\stop!
    Sound.playOnce "Units\\Human\\Knight\\KnightYes1.flac"
    print "Wrapper playOnce first call"
  step "Listen: the knight's voice spoke again", ->
    Sound.playOnce "Units\\Human\\Knight\\KnightYes1.flac"
    print "Wrapper playOnce second call"
  step "Listen: a footman's voice spoke just now", ->
    voice\setPosition 0, 0, 0
    voice\play!
    print "Wrapper 3D sound"
  step "Listen: silence. Nothing played just now", ->
    bell\playFor other
    Sound.playOnce "Sound\\Interface\\QuestNew.flac", player: other
    print "Wrapper playFor and playOnce for another player"
  step "Listen: the footman's voice spoke again", ->
    Sound.playOnce "Units\\Human\\Footman\\FootmanYes1.flac", x: 0, y: 0
    print "Wrapper playOnce 3D"

  start ->
    view\destroy!
    sight\destroy!
    bell\destroy!
    voice\destroy!
    marker\remove!
    print "Wrapper presentation cleanup passed"
    showPrompt "The presentation gate is done. Close the game."

-- v0.5.0 frames. Run with frames = true; the templates come from the gate map's TOC file. One thing at a time, Esc
-- for the next.
framesGate = (owner) ->
  other = Player.fromIndex 1
  Frame.loadTOC "war3mapImported\\wrappers-gate.toc"
  gameUi = Frame.origin ORIGIN_FRAME_GAME_UI
  panel = Frame.create "EscMenuBackdrop", gameUi
  panel\setAbsPoint FRAMEPOINT_CENTER, 0.4, 0.35
  panel\setSize 0.32, 0.3
  title = Frame.create "EscMenuTitleTextTemplate", panel
  title\setPoint FRAMEPOINT_TOP, panel, FRAMEPOINT_TOP, 0, -0.03
  title\setText "Wrapper frames"
  title\setTextColor 255, 220, 0, 255
  button = Frame.createByType "GLUETEXTBUTTON", panel, name: "WrapperClick", inherits: "ScriptDialogButton"
  button\setPoint FRAMEPOINT_TOP, title, FRAMEPOINT_BOTTOM, 0, -0.01
  button\setSize 0.14, 0.035
  button\setText "Click me"
  clicks = 0
  button\on FRAMEEVENT_CONTROL_CLICK, (player) ->
    clicks += 1
    button\releaseFocusFor player
    print "Wrapper frame clicked by", player\getName!, "count", clicks
  tip = Frame.create "EscMenuLabelTextTemplate", panel
  tip\setPoint FRAMEPOINT_BOTTOM, button, FRAMEPOINT_TOP, 0, 0.005
  tip\setText "Wrapper tooltip"
  button\setTooltip tip
  box = Frame.create "EscMenuEditBoxTemplate", panel
  box\setPoint FRAMEPOINT_TOP, button, FRAMEPOINT_BOTTOM, 0, -0.01
  box\setSize 0.2, 0.03
  box\on FRAMEEVENT_EDITBOX_ENTER, (player, event) ->
    print "Wrapper edit box enter by", player\getName!, event.text
  slider = Frame.create "EscMenuSliderTemplate", panel
  slider\setPoint FRAMEPOINT_TOP, box, FRAMEPOINT_BOTTOM, 0, -0.015
  slider\setSize 0.2, 0.012
  slider\setMinMaxValue 0, 10
  slider\setStepSize 1
  slider\setValue 5
  slider\on FRAMEEVENT_SLIDER_VALUE_CHANGED, (_, event) ->
    print "Wrapper slider value", event.value
  check = Frame.create "QuestCheckBox", panel
  check\setPoint FRAMEPOINT_TOPLEFT, slider, FRAMEPOINT_BOTTOMLEFT, 0, -0.015
  check\on FRAMEEVENT_CHECKBOX_CHECKED, (player) -> print "Wrapper checkbox checked by", player\getName!
  check\on FRAMEEVENT_CHECKBOX_UNCHECKED, (player) -> print "Wrapper checkbox unchecked by", player\getName!
  hidden = Frame.create "EscMenuLabelTextTemplate", panel
  hidden\setPoint FRAMEPOINT_BOTTOMLEFT, panel, FRAMEPOINT_BOTTOMLEFT, 0.03, 0.03
  hidden\setText "ERROR visible for another player"
  hidden\setVisibleFor other
  badge = Frame.createByType "BACKDROP", gameUi, name: "WrapperBadge"
  badge\setTexture "ReplaceableTextures\\CommandButtons\\BTNFootman.blp"
  badge\setSize 0.04, 0.04
  badge\setAbsPoint FRAMEPOINT_TOPLEFT, 0.02, 0.55
  closeButton = Frame.createByType "GLUETEXTBUTTON", panel, name: "WrapperClose", inherits: "ScriptDialogButton"
  closeButton\setPoint FRAMEPOINT_BOTTOMRIGHT, panel, FRAMEPOINT_BOTTOMRIGHT, -0.03, 0.025
  closeButton\setSize 0.09, 0.03
  closeButton\setText "Close"
  closeButton\on FRAMEEVENT_CONTROL_CLICK, ->
    panel\destroy!
    print "Wrapper frames closed; badge disposed", badge\isDisposed!, "button disposed", button\isDisposed!
  print "Wrapper frames shown:", panel\getName!, "children", panel\getChildrenCount!
  step, start = stepByStep owner, "Wrapper frames"
  step "Look: a panel 'Wrapper frames': a button, an edit box, a slider, a check box, 'Close'. No ERROR text", -> nil
  step "Look: a footman icon in the top left corner of the screen", -> nil
  step "Do: hold the mouse over 'Click me'. The text 'Wrapper tooltip' shows above it", -> nil
  step "Do: click 'Click me' once, then press Enter. The chat box opens. Press Enter again to close it", -> nil
  step "Do: click in the edit box, type a word and press Enter", -> nil
  step "Do: drag the slider to another place", -> nil
  step "Do: tick the check box, then untick it", -> nil
  step "Look: the footman icon has jumped into the panel's top right corner", ->
    unless panel\isDisposed!
      badge\setParent panel
      badge\clearPoints!
      badge\setPoint FRAMEPOINT_TOPRIGHT, panel, FRAMEPOINT_TOPRIGHT, -0.03, -0.03
      print "Wrapper badge moved into the panel"
    nil
  step "Do: click 'Close'. The panel and the icon disappear", -> nil
  start ->
    print "Wrapper frames gate done; panel disposed", panel\isDisposed!
    showPrompt "The frames gate is done. Close the game."

-- v0.4.0 classic UI, after the dialog: a board, a leaderboard, quests and a timer dialog. One thing at a time, Esc for
-- the next.
uiBoards = (owner) ->
  other = Player.fromIndex 1
  footman = "ReplaceableTextures\\CommandButtons\\BTNFootman.blp"
  local board, leaders, quest, optional, first, defeat, countdown, clock
  step, start = stepByStep owner, "Wrapper ui"

  step "Look: top right, 'Wrapper multiboard' in yellow. Rows: Name, Kills / Footman + icon / Row 3. Icons at right", ->
    board = Multiboard.create 3, 3, "Wrapper multiboard"
    board\setTitleColor 255, 220, 0, 255
    board\setAll {showValue: true, showIcon: false, width: 0.05}
    board\setColumn 1, {width: 0.08}
    board\setCell 1, 1, {value: "Name", color: {255, 204, 0}}
    board\setCell 1, 2, {value: "Kills"}
    board\setCell 2, 1, {value: "Footman", icon: footman, showValue: true, showIcon: true}
    board\setRow 3, {value: "Row 3"}
    board\setColumn 3, {icon: footman, showValue: false, showIcon: true}
    board\setVisible true
    print "Wrapper multiboard", board\getTitle!, board\getRowCount!, board\getColumnCount!
  step "Look: the board has 6 rows now, and the last one reads 'Row 6'", ->
    board\setRowCount 6
    board\setRow 6, {value: "Row 6"}
    print "Wrapper multiboard rows", board\getRowCount!
  step "Look: the board has 2 rows now", ->
    board\setRowCount 2
    print "Wrapper multiboard rows", board\getRowCount!
  step "Look: the board is folded up: only its title shows", ->
    board\setMinimized true
    print "Wrapper multiboard minimized"
  step "Look: the board is unfolded again", ->
    board\setMinimized false
    print "Wrapper multiboard expanded"
  step "Look: the board is gone", ->
    board\setVisibleFor other
    print "Wrapper multiboard hidden for another player"
    -> board\destroy!

  step "Look: top right, 'Wrapper leaderboard' in yellow. 'Other' with a blue 9 stands above 'You' with 5", ->
    leaders = Leaderboard.create "Wrapper leaderboard"
    leaders\setLabelColor 255, 220, 0, 255
    leaders\addItem owner, "You", 5
    leaders\addItem other, "Other", 9
    leaders\setItemValueColor other, 0, 128, 255, 255
    leaders\sortByValue false
    leaders\assign owner
    leaders\setVisible true
    print "Wrapper leaderboard items", leaders\getItemCount!
  step "Look: 'You (12)' is on top now, and the icons are gone", ->
    leaders\setItemValue owner, 12
    leaders\setItemLabel owner, "You (12)"
    leaders\sortByValue false
    leaders\setStyle {icons: false}
    print "Wrapper leaderboard re-sorted"
  step "Look: 'Other' is gone. The board has one row", ->
    leaders\removeItem other
    print "Wrapper leaderboard items", leaders\getItemCount!, "has other", leaders\hasItem(other)
    -> leaders\destroy!

  step "Do: press F9. Listed: 'Wrapper quest', 'Wrapper optional quest', 'Wrapper defeat condition'. Close it", ->
    quest = Quest.create {title: "Wrapper quest", description: "Its first item completes next", icon: footman}
    first = quest\addItem "Wrapper first item"
    quest\addItem "Wrapper second item"
    optional = Quest.create {title: "Wrapper optional quest", description: "It fails two steps on.", required: false}
    defeat = DefeatCondition.create "Wrapper defeat condition"
    Quest.flashButton!
    print "Wrapper quests created: open the quest log (F9)"
  step "Do: press F9. The first item of 'Wrapper quest' is completed. Close it", ->
    first\setCompleted true
    Quest.refresh!
    print "Wrapper quest item completed", first\isCompleted!
  step "Do: press F9. 'Wrapper quest' is completed, 'Wrapper optional quest' failed. Close it", ->
    quest\setCompleted true
    optional\setFailed true
    Quest.refresh!
    print "Wrapper quest completed", quest\isCompleted!, "optional failed", optional\isFailed!

  step "Look: top right, 'Wrapper timer dialog' in yellow with a green time counting down from about 10:00", ->
    clock = Timer.create!
    clock\start 600, false, -> nil
    countdown = TimerDialog.create clock, "Wrapper timer dialog"
    countdown\setTitleColor 255, 220, 0, 255
    countdown\setTimeColor 0, 255, 0, 255
    countdown\setVisible true
    print "Wrapper timer dialog shown"
  step "Look: the time counts down faster now, about four seconds for each second", ->
    countdown\setSpeed 4
    print "Wrapper timer dialog speed 4"
  step "Look: the time has jumped to about 0:10", ->
    countdown\setRealTimeRemaining 10
    print "Wrapper timer dialog remaining 10"
  step "Look: the timer window is gone", ->
    countdown\setVisibleFor other
    print "Wrapper timer dialog hidden for another player"

  start ->
    countdown\destroy!
    clock\destroy!
    quest\destroy!
    optional\destroy!
    defeat\destroy!
    print "Wrapper ui cleanup passed; quest item disposed", first\isDisposed!
    showPrompt "The classic UI gate is done. Close the game."

-- v0.4.0 classic UI. Run with ui = true: the dialog first, whose title says what to press next; its last button
-- starts uiBoards.
uiGate = (owner) ->
  dialog = Dialog.create!
  dialog\setMessage "Wrapper dialog: press K"
  -- Warcraft hides a dialog when a button is clicked; show it again a moment later.
  reshow = (player, message) ->
    later = Timer.create!
    later\start 0.5, false, (self) ->
      self\destroy!
      unless dialog\isDisposed!
        dialog\setMessage message
        dialog\show player
  keyed = (player) ->
    print "Wrapper dialog keyed by", player\getName!
    reshow player, "Wrapper dialog: click Plain"
  dialog\addButton "Keyed (K)", keyed, hotkey: "K"
  dialog\addButton "Plain", (player) ->
    print "Wrapper dialog plain by", player\getName!
    reshow player, "Wrapper dialog: click Rebuild"
  dialog\addButton "Rebuild", (player) ->
    dialog\clear!
    dialog\addButton "After clear", (clicker) ->
      print "Wrapper dialog after clear by", clicker\getName!
      reshow clicker, "Wrapper dialog: click Destroy dialog"
    dialog\addButton "Destroy dialog", ->
      dialog\destroy!
      print "Wrapper dialog destroyed from its own button"
      uiBoards owner
    print "Wrapper dialog rebuilt"
    reshow player, "Wrapper dialog: click After clear"
  dialog\show owner
  print "Wrapper dialog shown: its title says what to press"

-- v0.7.0 port prerequisites. Run with port = true: one step per second. CONTRIBUTING step 13 lists every message.
portGate = (owner) ->
  hostile = Player.fromIndex 12
  striker = Unit.create owner, $FourCC("hfoo"), -200, 0, 0
  dummy = Unit.create hostile, $FourCC("hfoo"), 0, 0, 180
  striker\setPaused true
  dummy\setPaused true
  dummy\setMaxLife 5000
  dummy\setLife 5000
  print "Wrapper collision size", striker\getCollisionSize!
  for row = -4, 4
    Destructable.create $FourCC("LTlt"), 448, row * 128, 270, 1, 0
  step = 0
  nestedDone = false
  storedEvent = nil
  stopDamaging = Damage.onDamaging (event) ->
    if event.target == dummy
      if step == 2
        before = event.amount
        event\setAmount before * 2
        source = event.source
        sourceName = source and source\getName! or "none"
        print "Wrapper damaging", sourceName, event.target\getName!, event.isAttack, before, event.amount
      elseif step == 3
        event\setAttackType ATTACK_TYPE_MAGIC
      elseif step == 5 and not nestedDone
        nestedDone = true
        storedEvent = event
        striker\damageTarget dummy, 10, false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS
        event\setAmount 0
  stopDamaged = Damage.onDamaged (event) ->
    if event.target == dummy
      BlzSetEventAttackType ATTACK_TYPE_MAGIC if step == 4
      print "Wrapper damaged step", step, "amount", event.amount
  strike = ->
    lifeBefore = dummy\getLife!
    striker\damageTarget dummy, 100, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS
    print "Wrapper life loss step", step, lifeBefore - dummy\getLife!
  walker = nil
  longest = string.rep "s", 255
  Sync.on "wgate", (player, data) ->
    print "Wrapper sync received from", player\getName!, #data, data == longest
  Sync.on string.rep("p", 16), (_, data) -> print "Wrapper sync prefix 16 arrived", data
  Sync.on string.rep("q", 17), (_, data) -> print "Wrapper sync prefix 17 arrived whole", data
  Sync.on string.rep("q", 16), (_, data) -> print "Wrapper sync prefix 17 arrived cut to 16", data
  Sync.on string.rep("r", 32), (_, data) -> print "Wrapper sync prefix 32 arrived whole", data
  Sync.on string.rep("r", 16), (_, data) -> print "Wrapper sync prefix 32 arrived cut to 16", data
  steps = Timer.create!
  steps\start 1, true, (self) ->
    step += 1
    if step <= 5
      strike!
    elseif step == 6
      if storedEvent
        staleOk, staleMessage = pcall storedEvent.setAmount, storedEvent, 1
        print "Wrapper stale damage event", staleOk, staleMessage
      stopDamaging!
      stopDamaged!
    elseif step == 7
      strike!
      print "Wrapper damage listeners removed"
    elseif step == 8
      walker = Unit.create owner, $FourCC("hfoo"), 250, 0, 0
      walker\setPathing false
      walker\issuePointOrder "move", 650, 0
      print "Wrapper pathing walker ordered through the trees"
    elseif step == 12
      print "Wrapper pathing walker x", walker and walker\getX! or "none"
    elseif step == 13
      if owner\isLocal!
        print "Wrapper sync sent", Sync.send "wgate", longest
        rejectedOk, rejectedMessage = pcall Sync.send, "wgate", longest .. "s"
        print "Wrapper sync 256 bytes rejected", not rejectedOk, rejectedMessage
        Sync.send string.rep("p", 16), "sixteen"
        Sync.send string.rep("q", 17), "seventeen"
        Sync.send string.rep("r", 32), "thirty-two"
    elseif step == 15
      self\destroy!
      print "Wrapper port gate done"
  print "Wrapper port gate started: watch steps 1 to 15, one per second"

-- v0.8.0 additions. Run with additions = true. CONTRIBUTING step 14 lists every message. First lines to read, then
-- rain and one effect, one at a time, and six input steps; Esc goes on to the next.
ADDITIONS_WEATHER = {
  "RAhr", "RAlr", "RLhr", "RLlr", "SNbs", "SNhs", "SNls", "WOcw", "WOlw", "WNcw", "LRaa", "LRma", "MEds", "FDbh"
  "FDbl", "FDgh", "FDgl", "FDrh", "FDrl", "FDwh", "FDwl"
}
ADDITIONS_INPUT = {
  "tap Q once"
  "hold Q down for about two seconds, then let go"
  "hold Shift, tap Q once, then let go of Shift"
  "left-click the ground once"
  "move the mouse over the ground for about two seconds"
  "tap Q once and left-click the ground once (the listeners are removed now)"
}
additionsGate = (owner) ->
  say = (...) ->
    parts = {"Wrapper additions"}
    for index = 1, select "#", ...
      parts[#parts + 1] = tostring (select index, ...)
    print table.concat parts, " "

  -- Art from ability data.
  clapId = $FourCC "AHtc"
  clap = assert Effect.abilityArt(clapId, EFFECT_TYPE_CASTER), "Thunder Clap has no caster art"
  say "art: Thunder Clap caster", clap
  say "art: Thunder Clap missile", Effect.abilityArt clapId, EFFECT_TYPE_MISSILE
  say "art: Flame Strike special, third entry", Effect.abilityArt $FourCC("AHfs"), EFFECT_TYPE_SPECIAL, 3
  say "art: Chain Lightning lightning", Effect.abilityArt $FourCC("AOcl"), EFFECT_TYPE_LIGHTNING
  missingOk, missingMessage = pcall Effect.create, Effect.abilityArt(clapId, EFFECT_TYPE_MISSILE), 0, 0
  say "art: a missing art refused", not missingOk, missingMessage

  -- The four registrations, with fromEvent.
  rich = Trigger.create!
  rich\registerPlayerStateEvent owner, PLAYER_STATE_RESOURCE_GOLD, GREATER_THAN_OR_EQUAL, 1000
  rich\addAction ->
    say "player state: gold", owner\getGold!, "and the event's player is the owner:", Player.fromEvent! == owner
  owner\setGold 500
  owner\setGold 1000
  owner\setGold 1001
  rich\destroy!
  other = Player.fromIndex 1
  shared = owner\getAlliance other, ALLIANCE_SHARED_VISION
  changes = 0
  allied = Trigger.create!
  allied\registerPlayerAllianceChange owner, ALLIANCE_SHARED_VISION
  allied\addAction -> changes += 1
  owner\setAlliance other, ALLIANCE_SHARED_VISION, shared
  same = changes
  owner\setAlliance other, ALLIANCE_SHARED_VISION, not shared
  owner\setAlliance other, ALLIANCE_SHARED_VISION, shared
  say "alliance change: firings after the same value", same, "and after two changes", changes
  allied\destroy!
  noon = Trigger.create!
  noon\registerGameStateEvent GAME_STATE_TIME_OF_DAY, GREATER_THAN_OR_EQUAL, 12
  noon\addAction (self) ->
    say "game state: the time of day reached", string.format("%.2f", GetFloatGameState GAME_STATE_TIME_OF_DAY)
    self\destroy!
  SuspendTimeOfDay false
  SetFloatGameState GAME_STATE_TIME_OF_DAY, 11.99
  order = {}
  ticker = Timer.create!
  expiry = Trigger.create!
  expiry\registerTimerExpireEvent ticker
  expiry\addAction -> order[#order + 1] = "trigger for this timer " .. tostring(Timer.fromEvent! == ticker)
  ticker\start 0.5, false, (self) ->
    order[#order + 1] = "callback"
    say "timer expiry:", table.concat order, ", then "
    expiry\destroy!
    self\destroy!

  -- fromEvent for a unit, an item, a destructable and a region.
  footman = Unit.create owner, $FourCC("hfoo"), -700, -500, 0
  fallen = Trigger.create!
  fallen\registerUnitEvent footman, EVENT_UNIT_DEATH
  fallen\addAction -> say "event: the dying unit is the footman:", Unit.fromEvent! == footman
  footman\kill!
  hero = Unit.create owner, $FourCC("Hpal"), -700, -300, 0
  pickups = Trigger.create!
  pickups\registerUnitEvent hero, EVENT_UNIT_PICKUP_ITEM
  pickups\addAction ->
    picked = Item.fromEvent!
    say "event: picked up", picked and picked\getName!, "by the hero:", Unit.fromEvent! == hero
  assert hero\addItemById($FourCC("ratc")), "no item added"
  tree = Destructable.create $FourCC("LTlt"), -704, -704, 270, 1, 0
  felled = Trigger.create!
  felled\registerDeathEvent tree
  felled\addAction -> say "event: the dying destructable is the tree:", Destructable.fromEvent! == tree
  tree\kill!
  area = Rect.create -1000, 200, -800, 400
  zone = Region.create!
  zone\addRect area
  entered = Trigger.create!
  entered\registerEnterRegion zone
  entered\addAction ->
    say "event: the entered region is the zone:", Region.fromEvent! == zone, "by the hero:", Unit.fromEvent! == hero
  hero\setPosition -900, 300

  -- Weather: which of the game's ids exist, and an unknown one.
  field = Rect.create -1024, -1024, 1024, 1024
  created, refused = {}, {}
  for code in *ADDITIONS_WEATHER
    ok, made = pcall WeatherEffect.create, FourCC(code), field
    if ok
      made\destroy!
      created[#created + 1] = code
    else
      refused[#refused + 1] = code
  say "weather ids created:", #created, table.concat created, " "
  say "weather ids refused:", #refused, table.concat refused, " "
  unknownOk, unknownMessage = pcall WeatherEffect.create, FourCC("zzzz"), field
  say "weather: an unknown id refused", not unknownOk, unknownMessage
  rain = WeatherEffect.create $FourCC("RAhr"), field
  field\destroy!
  say "rain: created and its rect destroyed. Not enabled: no rain yet"

  -- The six input steps; Esc ends each one.
  inputGate = ->
    counts = {}
    reset = ->
      counts = {
        downs: 0, every: 0, repeated: 0, ups: 0, meta: "-", clicks: 0, click: "-", releases: 0, moves: 0
      }
    reset!
    cancels = {}
    listen = (cancel) -> cancels[#cancels + 1] = cancel
    listen Input.onKeyDown owner, OSKEY_Q, (player, meta) ->
      counts.downs += 1
      counts.meta = meta .. (player == owner and "" or " from another player")
    every = (_, _, repeated) ->
      counts.every += 1
      counts.repeated += 1 if repeated
    listen Input.onKeyDown owner, OSKEY_Q, every, repeats: true
    listen Input.onKeyUp owner, OSKEY_Q, -> counts.ups += 1
    listen Input.onMouseDown owner, (_, x, y, button) ->
      counts.clicks += 1
      name = button == MOUSE_BUTTON_TYPE_LEFT and "left" or button == MOUSE_BUTTON_TYPE_RIGHT and "right" or "other"
      counts.click = name .. string.format(" at %.0f %.0f", x, y)
    listen Input.onMouseUp owner, -> counts.releases += 1
    listen Input.onMouseMove owner, -> counts.moves += 1
    step = 1
    prompt = ->
      text = "The additions gate is done. Close the game."
      if ADDITIONS_INPUT[step]
        text = "Input step #{step} of #{#ADDITIONS_INPUT}. Do: #{ADDITIONS_INPUT[step]}. Then press Esc."
      showPrompt text
    escape = Trigger.create!
    escape\registerPlayerEvent owner, EVENT_PLAYER_END_CINEMATIC
    escape\addAction (self) ->
      say "input " .. step .. ": downs", counts.downs, "with repeats", counts.every, "of which repeated",
        counts.repeated, "ups", counts.ups, "meta", counts.meta, "clicks", counts.clicks, "(" .. counts.click .. ")",
        "releases", counts.releases, "moves", counts.moves
      reset!
      step += 1
      if step == #ADDITIONS_INPUT
        for cancel in *cancels
          cancel!
        say "input: every listener removed"
      if step > #ADDITIONS_INPUT
        self\destroy!
        say "gate done"
      prompt!
    prompt!

  -- Rain and one effect, one at a time, after the lines that arrive within the first second.
  rainStep, startRain = stepByStep owner, "Wrapper additions"
  rainStep "Look: no rain falls", -> nil
  rainStep "Look: rain falls in the middle of the screen (it takes a second or two to start)", ->
    rain\setEnabled true
    say "rain 1: enabled for everyone NOW"
  rainStep "Look: the rain has stopped (it takes a second or two)", ->
    rain\setEnabledFor other
    say "rain 2: enabled for another player only NOW"
  rainStep "Look: the rain falls again", ->
    rain\setEnabledFor owner
    say "rain 3: enabled for you only NOW"
  rainStep "Look: the rain has stopped", ->
    rain\destroy!
    say "rain 4: destroyed NOW"
  rainStep "Look: a Thunder Clap effect in the middle of the screen", ->
    thunder = Effect.create clap, 0, 0
    say "art: a Thunder Clap appears NOW in the middle"
    -> thunder\destroy!
  opening = Timer.create!
  opening\start 2, false, (self) ->
    self\destroy!
    startRain inputGate
  say "gate started: lines to read first, then one thing at a time"

-- v0.9.0 automatic disposal. Run with dispose = true. CONTRIBUTING step 15 lists every message. Nothing needs
-- watching; the run takes about four seconds.
disposeGate = (owner) ->
  say = (...) ->
    parts = {"Wrapper dispose"}
    for index = 1, select "#", ...
      parts[#parts + 1] = tostring (select index, ...)
    print table.concat parts, " "
  state = (unit) -> "disposed " .. tostring(unit\isDisposed!) .. " exists " .. tostring unit\exists!

  footman = $FourCC "hfoo"
  living = Unit.create owner, footman, -300, 0, 270
  removed = Unit.create owner, footman, -150, 0, 270
  exploded = Unit.create owner, footman, 0, 0, 270
  corpse = Unit.create owner, footman, 150, 0, 270
  hero = Unit.create owner, $FourCC("Hpal"), 300, 0, 270
  removedId = GetHandleId removed\getHandle!
  stop = Unit.autoDispose!
  RemoveUnit removed\getHandle!
  SetUnitExploded exploded\getHandle!, true
  exploded\kill!
  corpse\kill!
  hero\kill!
  Unit.sweep!
  say "1 same instant, after a sweep: removed", state(removed), "| exploded", state exploded

  -- How long the timer's sweep takes to notice, in steps of 0.05 seconds.
  waited = 0
  watch = Timer.create!
  watch\start 0.05, true, (self) ->
    waited += 1
    if removed\isDisposed!
      self\destroy!
      say "2 the timer's sweep disposed the removed unit after", string.format("%.2f", waited * 0.05), "s"

  tick = 0
  steps = Timer.create!
  steps\start 1, true, (self) ->
    tick += 1
    if tick == 1
      say "3 after 1 s: living", state(living), "| removed", state(removed), "| exploded", state(exploded),
        "| corpse", state(corpse), "| dead hero", state hero
      _, located = pcall -> print "ERROR no error for a swept unit", removed\getX!
      say "4 error:", located
      stop!
      stop!
      RemoveUnit living\getHandle!
    elseif tick == 2
      say "5 stopped, then removed by raw code:", state living
      Unit.sweep!
      say "6 after a sweep by hand: disposed", living\isDisposed!, "exists", living\exists!
      fresh = Unit.create owner, footman, -150, 0, 270
      say "7 handle ids: the removed unit had", removedId, "and a unit created now has", GetHandleId fresh\getHandle!
      fresh\remove!
    elseif tick == 3
      held = for index = 1, 200
        Unit.create owner, footman, -600 + 60 * (index % 20), -300 - 60 * math.floor((index - 1) / 20), 270
      started = os.clock!
      for _ = 1, 100
        Unit.sweep!
      elapsed = os.clock! - started
      say "8 sweep cost:", #held, "more wrappers,", string.format("%.1f", elapsed * 10000), "microseconds per sweep"
      for unit in *held
        unit\remove!
    else
      self\destroy!
      watch\destroy!
      say "9 corpse and dead hero at the end:", state(corpse), "|", state hero
      say "gate done"
  say "gate started: nothing to watch, about four seconds"

-- Start just after the map loads: text printed while it loads never reaches the screen or the message log.
mw.on_main ->
  start = Timer.create!
  start\start 0, false, (self) ->
    self\destroy!
    owner = Player.fromIndex 0
    if dispose
      disposeGate owner
    elseif additions
      additionsGate owner
    elseif port
      portGate owner
    elseif frames
      framesGate owner
    elseif ui
      uiGate owner
    elseif presentation
      presentationGate owner
    else
      foundationGate owner
      broadGate owner
