import "moonwell" as mw
import "wrappers.unit" as Unit
import "wrappers.player" as Player
import "wrappers.timer" as Timer
import "wrappers.group" as Group
import "wrappers.texttag" as TextTag
import "wrappers.dialog" as Dialog
import "wrappers.damage" as Damage
import "wrappers.sync" as Sync

mw.on_main ->
  unit = Unit.create Player.fromIndex(0), 1751543663, 0, 0, 270
  unit\setLife 250
  group = Group.create!
  group\add unit
  timer = Timer.create!
  timer\start 1, false, (self) ->
    group\destroy!
    unit\remove!
    self\destroy!
  TextTag.float "+1", 0, 0, size: 12, color: {255, 0, 0}
  dialog = Dialog.create!
  dialog\addButton "Stay", (player) -> player\addGold 10
  listener = Damage.onDamaging (event) ->
    event\setAmount event.amount * 2
    event\setDamageType DAMAGE_TYPE_UNIVERSAL
  Damage.off listener
  Sync.on "load", (player, data) -> print player\getName!, data
  print unit\getCollisionSize!
  unit\setPathing false
